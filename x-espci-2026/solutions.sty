% \doctitle{Paper}{Track / paper number}{Duration line}{Document type}
\newcommand{\doctitle}[4]{%
  \renewcommand{\papername}{#1}\renewcommand{\doctype}{#4}%
  \thispagestyle{plain}%
  \begin{center}
    {\sffamily\small ÉCOLE POLYTECHNIQUE \,--\, ESPCI \,$\cdot$\, ADMISSION EXAM 2026}\\[6pt]
    {\sffamily\bfseries\LARGE\color{heading} #1}\\[4pt]
    {\sffamily\large #2}\\[2pt]
    {\small #3}\\[8pt]
    {\sffamily\bfseries\large #4}
  \end{center}
  \vspace{2pt}\noindent\rule{\textwidth}{0.6pt}\par\vspace{4pt}}

\newcommand{\partheading}[1]{\par\bigskip\noindent{\sffamily\bfseries\Large\color{heading} #1}\par
  \vspace{2pt}\noindent{\color{heading}\rule{\textwidth}{0.4pt}}\par\medskip}
\newcommand{\subpart}[1]{\par\medskip\noindent{\sffamily\bfseries\color{heading} #1}\par\smallskip}
\newcommand{\question}[1]{\par\medskip\noindent{\sffamily\bfseries\color{heading} #1.}\enspace}

